# ───────── Frontend (public; VITE_ vars are embedded in the browser bundle) ─────────
VITE_GITHUB_USERNAME=rohithvarma2000
# Comma-separated exact repo names to feature first (optional)
VITE_FEATURED_REPOS=
VITE_LINKEDIN_URL=https://www.linkedin.com/in/rohithvarma2000/
# Optional hero background image path or URL, e.g. /images/background.jpg
VITE_HERO_BACKGROUND=
# Supabase: only the URL and the ANON (public) key. Never put the service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Leave empty on Vercel (same origin). Set only if the API is hosted elsewhere.
VITE_API_BASE=

# ───────── Server only (set in Vercel → Settings → Environment Variables; NEVER commit) ─────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Email notifications (Resend)
RESEND_API_KEY=
NOTIFY_TO_EMAIL=vishnurohithvarma@gmail.com
# Must be a sender verified in Resend (e.g. "Portfolio <notify@yourdomain.com>")
NOTIFY_FROM_EMAIL=
# Random string used to hash visitor IPs for rate limiting (never stores raw IPs)
IP_HASH_SALT=
# AI assistant. provider: anthropic | openai (any OpenAI-compatible endpoint)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
# Only for AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
# GitHub username the assistant may read public repos from (defaults to VITE_GITHUB_USERNAME)
GITHUB_USERNAME=rohithvarma2000
# Allowed browser origin(s) for the API, comma-separated (e.g. https://yourdomain.com). Empty = same-origin only.
ALLOWED_ORIGINS=
